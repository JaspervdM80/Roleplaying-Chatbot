<MudDialog Class="app-confirm-dialog">
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        @if (CancelIsMain)
        {
            <MudButton Color="Color.Error" OnClick="() => Dialog.Close(true)">@ConfirmText</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Cancel()">@CancelText</MudButton>
        }
        else
        {
            <MudButton OnClick="() => Dialog.Cancel()">@CancelText</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="() => Dialog.Close(true)">@ConfirmText</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    /// <summary>Makes backing out the highlighted choice, for a confirmation that throws work away.</summary>
    [Parameter]
    public bool CancelIsMain { get; set; }
}
