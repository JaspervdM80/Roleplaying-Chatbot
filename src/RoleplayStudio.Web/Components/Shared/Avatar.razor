@if (ImageId is { } imageId)
{
    <div class="app-avatar app-avatar-picture @Class" style="--avatar-size: @(Size)px" aria-hidden="true">
        <img src="@ImageEndpoints.Url(imageId)" alt="" loading="lazy" />
    </div>
}
else
{
    <div class="app-avatar @Class" style="--avatar-size: @(Size)px; @ToneStyle" aria-hidden="true">@Letter</div>
}

@code {
    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>The reference portrait to crop the avatar from; without one the avatar is the first letter of the name.</summary>
    [Parameter]
    public Guid? ImageId { get; set; }

    [Parameter]
    public int Size { get; set; } = 40;

    [Parameter]
    public string? Class { get; set; }

    // An unsaved entity has no id yet, so it waits in a neutral colour rather than showing one that changes on save.
    private string ToneStyle => Id == Guid.Empty
        ? "--avatar-ink: var(--ink-muted); --avatar-tint: var(--selected)"
        : $"--avatar-ink: var(--tone-{Tone}); --avatar-tint: var(--tone-{Tone}-tint)";

    private int Tone => (int)((uint)Id.GetHashCode() % (uint)AppTheme.ToneCount);

    private string Letter => string.IsNullOrWhiteSpace(Name) ? "?" : Name.Trim().EnumerateRunes().First().ToString().ToUpperInvariant();
}
