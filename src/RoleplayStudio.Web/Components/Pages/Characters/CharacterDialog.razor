<MudDialog Class="app-sheet-dialog">
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_character.Name" Label="Name" Required="true" MaxLength="100" Variant="Variant.Outlined" />
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_character.Age" Label="Age" Min="0" Variant="Variant.Outlined" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_character.Gender" Label="Gender" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="_character.ShortDescription" Label="In a sentence" Lines="2" Sizing="InputSizing.Auto" MaxLines="4" Variant="Variant.Outlined"
                          HelperText="Shown in lists and given to the model first." />
            <MudExpansionPanels Outlined="true" MultiExpansion="true">
                <MudExpansionPanel Text="Personality and voice">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_character.Personality" Label="Personality" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_character.SpeechStyle" Label="Speech style" Lines="2" Sizing="InputSizing.Auto" MaxLines="6" Variant="Variant.Outlined"
                                      Placeholder="Dry humour, short sentences, calls everyone 'love'…" />
                        <MudTextField @bind-Value="_character.Backstory" Label="Backstory" Lines="3" Sizing="InputSizing.Auto" MaxLines="12" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_character.Boundaries" Label="Boundaries" Lines="2" Sizing="InputSizing.Auto" MaxLines="6" Variant="Variant.Outlined"
                                      HelperText="What this character won't do or talk about." />
                    </MudStack>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Appearance">
                    <AppearanceFields Appearance="_character.Appearance" />
                </MudExpansionPanel>
                <MudExpansionPanel Text="Default outfit">
                    <MudText Typo="Typo.body2" Class="mb-2 app-list-card-detail">What they wear when a chat starts. Each chat keeps track of outfit changes on its own.</MudText>
                    <OutfitFields Outfit="_character.DefaultOutfit" />
                </MudExpansionPanel>
                <MudExpansionPanel Text="Images">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_character.ImageTags" Label="Image tags" Variant="Variant.Outlined"
                                      HelperText="Comma-separated tags added to every picture of this character." />
                        <MudNumericField @bind-Value="_character.ImageSeed" Label="Seed" Variant="Variant.Outlined" HideSpinButtons="true"
                                         HelperText="Reusing one seed keeps pictures more consistent. Leave empty for a random one." />
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>
