@page "/chats/{Id:guid}"
@attribute [Authorize]
@inherits CancellableComponent
@using RoleplayStudio.AI.Chat

<PageTitle>@(_session?.Title ?? "Chat") · Roleplay Studio</PageTitle>

<div class="chat">
    <div class="chat-main">
        @if (_session is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <div class="chat-header">
                <div class="chat-header-title">
                    <MudText Typo="Typo.h6" HtmlTag="h1">@_session.Title</MudText>
                    <MudText Typo="Typo.body2" Class="app-list-card-detail">
                        <MudLink Href="@AppRoutes.Chatbot(_session.Scenario.ChatbotId)">@_session.Scenario.Chatbot.Name</MudLink> · as @_session.Persona.Name
                    </MudText>
                </div>
                <MudSelect T="Guid?" Value="_session.ChatModelProfileId" ValueChanged="SetModelAsync" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="_streaming" Class="chat-model">
                    @foreach (var profile in _chatModels)
                    {
                        <MudSelectItem T="Guid?" Value="profile.Id">@profile.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ViewSidebar" OnClick="ToggleScene" Class="chat-scene-toggle">Scene</MudButton>
            </div>
        }

        <ChatTranscript @ref="_transcript" Turns="_turns" Streaming="_streaming" Portraits="_portraits">
            <TurnFooter Context="entry">
                <TurnPictures Turn="entry.Turn" Pictures="PicturesOf(entry.Turn)" Pending="PendingOf(entry.Turn)" Subjects="_subjects" Disabled="_streaming"
                              Actions="entry.EndsTurn" OnPicture="subject => PictureAsync(entry.Turn, subject)" OnOpen="OpenAsync" OnCancel="CancelPictureAsync" />
            </TurnFooter>
        </ChatTranscript>

        <div role="group" aria-label="Director" class="chat-director">
            <MudMenu Disabled="!CanDirect || _subjects.Count == 0" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
                <ActivatorContent>
                    <button type="button" class="chat-director-chip" disabled="@(!CanDirect || _subjects.Count == 0)">
                        Let someone answer <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var (id, name) in _subjects)
                    {
                        <MudMenuItem OnClick="() => DirectFromMenu(new DirectorHint.LetRespond(id))">@name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
            <MudMenu Disabled="!CanDirect || Offstage.Count == 0" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
                <ActivatorContent>
                    <button type="button" class="chat-director-chip" disabled="@(!CanDirect || Offstage.Count == 0)">
                        Bring someone in <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var character in Offstage)
                    {
                        <MudMenuItem OnClick="() => DirectFromMenu(new DirectorHint.BringIn(character.Id))">@character.Name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
            <button type="button" class="chat-director-chip" disabled="@(!CanDirect)" @onclick="() => DirectAsync(new DirectorHint.SkipAhead())">Skip ahead</button>
            <button type="button" class="chat-director-chip" disabled="@(!CanDirect)" @onclick="MoveSceneAsync">Move the scene</button>
            <button type="button" class="chat-director-chip" disabled="@(!CanDirect)" @onclick="() => DirectAsync(new DirectorHint.NarrationOnly())">Narration only</button>
        </div>

        <div class="chat-input">
            <MudTextField @bind-Value="_draft" Placeholder="Say something…" Lines="1" Sizing="InputSizing.Auto" MaxLines="6" Variant="Variant.Outlined"
                          Immediate="true" Disabled="_streaming || _session is null" OnKeyDown="OnDraftKeyDown" aria-label="Message" />
            @if (_streaming)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Stop">Stop</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanSend" OnClick="SendAsync">Send</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="More chat actions" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" Disabled="_session is null">
                    <MudMenuItem OnClick="ContinueAsync">Let them continue</MudMenuItem>
                </MudMenu>
            }
        </div>
    </div>

    @if (_session is not null)
    {
        <ScenePanel Session="_session" Toggled="_sceneToggled" OnClose="ToggleScene" Pictures="_pictures" Pending="_pending" OnOpen="OpenAsync" />
    }
</div>
