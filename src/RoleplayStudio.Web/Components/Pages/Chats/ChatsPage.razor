@page "/chats"
@attribute [Authorize]
@inherits CancellableComponent

<PageTitle>Chats · Roleplay Studio</PageTitle>

<div class="app-page-heading">
    <MudText Typo="Typo.h4" HtmlTag="h1">Chats</MudText>
    <MudButton Variant="Variant.Outlined" Href="@AppRoutes.Chatbots">New chat</MudButton>
</div>

@if (_chats is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_chats.Count == 0)
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">No chats yet</MudText>
        <MudText Class="mt-2">Open a <MudLink Href="@AppRoutes.Chatbots">chatbot</MudLink> and start a chat from one of its scenarios.</MudText>
    </MudPaper>
}
else
{
    <section aria-labelledby="chats-continue">
        <h2 id="chats-continue" class="chats-heading">Continue</h2>
        <ul class="chats-list">
            @foreach (var chat in _chats)
            {
                <li class="chats-row" @key="chat.Id">
                    <a class="chats-link" href="@AppRoutes.Chat(chat.Id)">
                        <span class="chats-faces">
                            @if (chat.Characters.Count == 0)
                            {
                                <Avatar Id="chat.Id" Name="@chat.ChatbotName" Size="36" />
                            }
                            @foreach (var character in chat.Characters.Take(3))
                            {
                                <Avatar Id="character.Id" Name="@character.Name" Size="36" />
                            }
                            @if (chat.Characters.Count > 1)
                            {
                                <span class="chats-more" aria-hidden="true">+@(chat.Characters.Count - 1)</span>
                            }
                            @if (chat.Characters.Count > 3)
                            {
                                <span class="chats-beyond" aria-hidden="true">+@(chat.Characters.Count - 3)</span>
                            }
                        </span>
                        <span class="chats-text">
                            <span class="chats-title">
                                <span class="chats-chatbot">@chat.ChatbotName</span>
                                <span class="chats-scenario">@chat.ScenarioTitle</span>
                            </span>
                            @if (chat.LastLine is not null)
                            {
                                <span class="chats-last">@chat.LastLine</span>
                            }
                        </span>
                        <span class="chats-persona">as @chat.PersonaName</span>
                        <span class="chats-when">@Wording.Ago(chat.LastActivityAt, Time)</span>
                    </a>
                    <MudMenu Class="chats-menu" Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"More actions for {chat.ChatbotName}: {chat.ScenarioTitle}")"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="() => DeleteAsync(chat)">Delete chat</MudMenuItem>
                    </MudMenu>
                </li>
            }
        </ul>
    </section>
}
