@inherits EntityEditor<Persona>
@using RoleplayStudio.Domain.Authoring

<EditorSheet @ref="Sheet" Kind="@Kind" Title="@Title" Sections="Sections" IsDirty="IsDirty" DiscardMessage="@DiscardMessage"
             ProblemSection="@ProblemSection" Saving="Saving" OnSave="SaveAsync">
    <Portrait>
        <div class="app-editor-portrait">
            <Avatar Id="Persona?.Id ?? Guid.Empty" Name="@Edited.Name" Size="96" Class="app-editor-portrait-letter" />
            <span class="app-editor-portrait-note">No portrait yet</span>
        </div>
    </Portrait>
    <ChildContent>
        <EditorSectionBlock Section="Identity">
            <div data-field="@nameof(Persona.Name)">
                <MudTextField @bind-Value="Edited.Name" @bind-Value:after="Changed" Label="Name" Required="true" MaxLength="100" Variant="Variant.Outlined"
                              Error="IsProblem(nameof(Persona.Name))" ErrorText="@Problem?.Message" />
            </div>
            <div class="app-editor-row">
                <div class="app-editor-narrow" data-field="@nameof(Persona.Age)">
                    <MudNumericField @bind-Value="Edited.Age" @bind-Value:after="Changed" Label="Age" Variant="Variant.Outlined" HideSpinButtons="true"
                                     Error="IsProblem(nameof(Persona.Age))" ErrorText="@Problem?.Message" />
                </div>
                <MudTextField @bind-Value="Edited.Gender" @bind-Value:after="Changed" Label="Gender" Variant="Variant.Outlined" />
            </div>
        </EditorSectionBlock>

        <EditorSectionBlock Section="About">
            <MudTextField @bind-Value="Edited.Description" @bind-Value:after="Changed" Label="Who you are" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" Variant="Variant.Outlined"
                          HelperText="What the characters know about you." />
            <MudTextField @bind-Value="Edited.Personality" @bind-Value:after="Changed" Label="Personality" Lines="2" Sizing="InputSizing.Auto" MaxLines="8" Variant="Variant.Outlined" />
        </EditorSectionBlock>

        <EditorSectionBlock Section="Looks">
            <MudTextField @bind-Value="Edited.Appearance" @bind-Value:after="Changed" Label="Appearance" Lines="4" Sizing="InputSizing.Auto" MaxLines="14" Variant="Variant.Outlined"
                          Placeholder="Short and freckled, with a mess of red curls and green eyes…"
                          HelperText="How you look in every scene: build, face, hair, eyes, anything that stands out." />
        </EditorSectionBlock>

        <EditorSectionBlock Section="Outfit">
            <MudTextField @bind-Value="Edited.DefaultOutfit" @bind-Value:after="Changed" Label="Outfit" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" Variant="Variant.Outlined"
                          Placeholder="A yellow raincoat over a striped jumper, jeans and green wellies…"
                          HelperText="What you wear when a chat starts. Each chat keeps track of outfit changes on its own." />
        </EditorSectionBlock>
    </ChildContent>
</EditorSheet>
