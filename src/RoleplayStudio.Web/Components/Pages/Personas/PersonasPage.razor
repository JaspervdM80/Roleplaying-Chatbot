@page "/personas"
@attribute [Authorize]
@inherits CancellableComponent

<PageTitle>Personas · Roleplay Studio</PageTitle>

<div class="app-page-heading">
    <MudText Typo="Typo.h4" HtmlTag="h1">Personas</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add persona</MudButton>
</div>

@if (_personas is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_personas.Count == 0)
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">No personas yet</MudText>
        <MudText Class="mt-2">A persona is who you play in a chat: your name, looks and what the characters know about you. Use one in any chatbot.</MudText>
    </MudPaper>
}
else
{
    <MudStack Spacing="2">
        @foreach (var persona in _personas)
        {
            <MudPaper Class="app-list-card pa-3" Outlined="true" @key="persona.Id">
                <Avatar Id="persona.Id" Name="@persona.Name" />
                <div class="app-list-card-main">
                    <div class="app-list-card-title">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@persona.Name</MudText>
                    </div>
                    @if (persona.Description is not null)
                    {
                        <MudText Typo="Typo.body2" Class="app-list-card-detail">@persona.Description</MudText>
                    }
                </div>
                <div class="app-list-card-actions">
                    <MudButton Variant="Variant.Outlined" OnClick="() => EditAsync(persona)">Edit</MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"More actions for {persona.Name}")" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="() => DeleteAsync(persona)">Delete</MudMenuItem>
                    </MudMenu>
                </div>
            </MudPaper>
        }
    </MudStack>
}
