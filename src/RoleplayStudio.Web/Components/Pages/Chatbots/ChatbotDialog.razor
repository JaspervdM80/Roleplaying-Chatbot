@inherits EntityEditor<Chatbot>
@using RoleplayStudio.Domain.Authoring

<EditorSheet @ref="Sheet" Kind="@Kind" Title="@Title" Sections="Sections" IsDirty="IsDirty" DiscardMessage="@DiscardMessage"
             ProblemSection="@ProblemSection" Saving="Saving" OnSave="SaveAsync">
    <EditorSectionBlock Section="About">
        <div data-field="@nameof(Chatbot.Name)">
            <MudTextField @bind-Value="Edited.Name" @bind-Value:after="Changed" Label="Name" Required="true" MaxLength="100" Variant="Variant.Outlined"
                          Error="IsProblem(nameof(Chatbot.Name))" ErrorText="@Problem?.Message" />
        </div>
        <MudTextField @bind-Value="Edited.Tagline" Label="Tagline" Variant="Variant.Outlined" Placeholder="A sleepy seaside café with a secret"
                      HelperText="One line on the chatbots list." />
    </EditorSectionBlock>

    <EditorSectionBlock Section="World">
        <MudTextField @bind-Value="Edited.WorldDescription" Label="World" Lines="5" Sizing="InputSizing.Auto" MaxLines="16" Variant="Variant.Outlined"
                      HelperText="The setting every chat in this chatbot shares." />
        <MudTextField @bind-Value="Edited.ToneAndRules" Label="Tone and rules" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" Variant="Variant.Outlined"
                      Placeholder="Wholesome but cheeky. Keep replies to a few paragraphs." />
    </EditorSectionBlock>

    <EditorSectionBlock Section="Settings">
        <MudSelect T="Guid?" @bind-Value="Edited.DefaultChatModelProfileId" Label="Chat model" Variant="Variant.Outlined" Clearable="true"
                   HelperText="Leave empty to use your default chat model.">
            @foreach (var profile in _chatModels)
            {
                <MudSelectItem T="Guid?" Value="profile.Id">@profile.Name (@profile.ModelId)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="Edited.ImageStylePreset" Label="Image style" Variant="Variant.Outlined" Placeholder="Soft watercolour, warm light"
                      HelperText="Used once pictures arrive." />
    </EditorSectionBlock>
</EditorSheet>
