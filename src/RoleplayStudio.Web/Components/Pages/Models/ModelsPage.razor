@page "/models"
@attribute [Authorize]
@inherits CancellableComponent

<PageTitle>Models · Roleplay Studio</PageTitle>

<div class="app-page-heading">
    <MudText Typo="Typo.h4" HtmlTag="h1">Models</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add model</MudButton>
</div>

@if (_profiles is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_profiles.Count == 0)
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">No models yet</MudText>
        <MudText Class="mt-2">
            Add a cloud model from OpenRouter or Featherless, a local one from Ollama, or an image model from Runware. API keys stay out of the database:
            a model names the setting that holds its key, which you set with <code>dotnet user-secrets</code>.
        </MudText>
    </MudPaper>
}
else
{
    <MudStack Spacing="2">
        @foreach (var profile in _profiles)
        {
            <MudPaper Class="app-list-card pa-3" Outlined="true" @key="profile.Id">
                <div class="app-list-card-main">
                    <div class="app-list-card-title">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@profile.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@profile.Role</MudChip>
                        @if (profile.IsDefault)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Class="app-list-card-detail">@ProviderLabel(profile) · @profile.ModelId</MudText>
                    @if (_checks.TryGetValue(profile.Id, out var check))
                    {
                        <MudText Typo="Typo.body2" Color="@(check.Ok ? Color.Success : Color.Error)" Class="mt-1">@check.Text</MudText>
                        @if (check.ImageId is { } imageId)
                        {
                            <img src="@ImageEndpoints.Url(imageId)" alt="Test picture from @profile.Name" class="app-model-test-picture mt-2" />
                        }
                    }
                </div>
                <div class="app-list-card-actions">
                    <MudButton Variant="Variant.Outlined" Disabled="_testing.Contains(profile.Id)" OnClick="() => TestAsync(profile)">
                        @(_testing.Contains(profile.Id) ? "Testing…" : "Test")
                    </MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"More actions for {profile.Name}")" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="() => EditAsync(profile)">Edit</MudMenuItem>
                        @if (ModelProfile.CanChat(profile.Provider))
                        {
                            <MudMenuItem Href="@AppRoutes.PlaygroundWith(profile.Id)">Try in playground</MudMenuItem>
                        }
                        @if (!profile.IsDefault)
                        {
                            <MudMenuItem OnClick="() => MakeDefaultAsync(profile)">Make default</MudMenuItem>
                        }
                        <MudMenuItem OnClick="() => DeleteAsync(profile)">Delete</MudMenuItem>
                    </MudMenu>
                </div>
            </MudPaper>
        }
    </MudStack>
}
